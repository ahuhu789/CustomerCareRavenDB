@model CustomerCareRavenDB.ViewModels.FeedbackFormViewModel
@{ ViewData["Title"] = "Thêm phản hồi"; }
<h2>Thêm phản hồi</h2>
<form asp-action="Create" method="post" class="card card-body shadow-sm">
