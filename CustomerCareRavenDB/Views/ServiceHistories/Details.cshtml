@model CustomerCareRavenDB.Models.ServiceHistory
@{ ViewData["Title"] = "Chi tiết lịch sử"; }
<h2>Chi tiết lịch sử chăm sóc</h2>
<div class="card card-body shadow-sm"><dl class="row">
    <dt class="col-sm-3">Mã document</dt><dd class="col-sm-9"><code>@Model.Id</code></dd>
    <dt class="col-sm-3">Lịch hẹn</dt><dd class="col-sm-9"><code>@Model.AppointmentId</code></dd>
    <dt class="col-sm-3">Khách hàng</dt><dd class="col-sm-9">@ViewBag.CustomerName (<code>@Model.CustomerId</code>)</dd>
    <dt class="col-sm-3">Dịch vụ</dt><dd class="col-sm-9">@ViewBag.ServiceName (<code>@Model.ServiceId</code>)</dd>
    <dt class="col-sm-3">Nhân viên</dt><dd class="col-sm-9">@ViewBag.StaffName (<code>@Model.StaffId</code>)</dd>
    <dt class="col-sm-3">Ngày thực hiện (UTC)</dt><dd class="col-sm-9">@Model.ServiceDate.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Mô tả công việc</dt><dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Kết quả</dt><dd class="col-sm-9">@Model.Result</dd>
    <dt class="col-sm-3">Ghi chú</dt><dd class="col-sm-9">@Model.Note</dd>
</dl><div><a class="btn btn-warning" href="@(Url.Action("Edit", "ServiceHistories") + "?id=" + Uri.EscapeDataString(Model.Id))">Sửa</a> <a class="btn btn-outline-secondary" asp-action="Index">Danh sách</a></div></div>
