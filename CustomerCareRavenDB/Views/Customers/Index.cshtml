@model IEnumerable<CustomerCareRavenDB.Models.Customer>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý khách hàng</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm khách hàng
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input name="keyword"
                   value="@ViewBag.Keyword"
                   class="form-control"
                   placeholder="Tìm theo tên, số điện thoại, email..." />
        </div>

        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Active"
                        selected="@(ViewBag.Status?.ToString() == "Active")">
                    Active
                </option>
                <option value="Inactive"
                        selected="@(ViewBag.Status?.ToString() == "Inactive")">
                    Inactive
                </option>
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-success">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-secondary">Đặt lại</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Họ tên</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Địa chỉ</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th style="min-width: 190px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.FullName</td>
                            <td>@customer.Phone</td>
                            <td>@customer.Email</td>
                            <td>@customer.Address</td>
                            <td>
                                @if (customer.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @customer.Status
                                    </span>
                                }
                            </td>
                            <td>@customer.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="@(Url.Action("Details") + "?id=" + Uri.EscapeDataString(customer.Id))"
                                   class="btn btn-sm btn-info">Chi tiết</a>

                                <a href="@(Url.Action("Edit") + "?id=" + Uri.EscapeDataString(customer.Id))"
                                   class="btn btn-sm btn-warning">Sửa</a>

                                <a href="@(Url.Action("Delete") + "?id=" + Uri.EscapeDataString(customer.Id))"
                                   class="btn btn-sm btn-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Chưa có khách hàng hoặc không tìm thấy kết quả.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
