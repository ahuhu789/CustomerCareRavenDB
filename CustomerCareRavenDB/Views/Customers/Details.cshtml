@model CustomerCareRavenDB.Models.Customer

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Chi tiết khách hàng</h2>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            Thông tin khách hàng
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-md-3">Mã khách hàng</dt>
                <dd class="col-md-9">@Model.Id</dd>

                <dt class="col-md-3">Họ và tên</dt>
                <dd class="col-md-9">@Model.FullName</dd>

                <dt class="col-md-3">Số điện thoại</dt>
                <dd class="col-md-9">@Model.Phone</dd>

                <dt class="col-md-3">Email</dt>
                <dd class="col-md-9">@Model.Email</dd>

                <dt class="col-md-3">Ngày sinh</dt>
                <dd class="col-md-9">
                    @(Model.Birthday?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")
                </dd>

                <dt class="col-md-3">Giới tính</dt>
                <dd class="col-md-9">
                    @(Model.Gender switch
                    {
                        "Male" => "Nam",
                        "Female" => "Nữ",
                        "Other" => "Khác",
                        _ => "Chưa cập nhật"
                    })
                </dd>

                <dt class="col-md-3">Địa chỉ</dt>
                <dd class="col-md-9">
                    @(Model.Address?.ToString() is { Length: > 0 } address
                                        ? address
                                        : "Chưa cập nhật")
                </dd>

                <dt class="col-md-3">Trạng thái</dt>
                <dd class="col-md-9">
                    @if (Model.Status == "Active")
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @(Model.Status == "Inactive"
                                                    ? "Ngừng hoạt động"
                                                    : Model.Status)
                    </span>
                                        }
                </dd>

                <dt class="col-md-3">Ngày tạo</dt>
                <dd class="col-md-9">
                    @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </dd>
            </dl>
        </div>

        <div class="card-footer">
            <a href="@(Url.Action("Edit") + "?id=" + Uri.EscapeDataString(Model.Id))"
               class="btn btn-warning">
                Chỉnh sửa
            </a>

            <a href="@(Url.Action("Delete") + "?id=" + Uri.EscapeDataString(Model.Id))"
               class="btn btn-danger">
                Xóa khách hàng
            </a>
        </div>
    </div>
</div>
