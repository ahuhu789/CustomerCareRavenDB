@model IReadOnlyList<CustomerCareRavenDB.Models.Service>
@{
    ViewData["Title"] = "Quản lý dịch vụ";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-gear"></i> Quản lý dịch vụ</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus"></i> Thêm dịch vụ</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Tìm tên hoặc loại dịch vụ (bắt đầu bằng...)" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button></div>
    <div class="col-auto"><a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div>
</form>
<div class="table-responsive bg-white rounded shadow-sm">
<table class="table table-striped table-hover mb-0 align-middle">
    <thead class="table-light"><tr><th>Tên dịch vụ</th><th>Loại</th><th class="text-end">Giá (VNĐ)</th><th>Ngày tạo (UTC)</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td><td>@item.Category</td><td class="text-end">@item.Price.ToString("N0")</td><td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-info" href="@(Url.Action("Details", "Services") + "?id=" + Uri.EscapeDataString(item.Id))">Xem</a>
                <a class="btn btn-sm btn-outline-warning" href="@(Url.Action("Edit", "Services") + "?id=" + Uri.EscapeDataString(item.Id))">Sửa</a>
                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa dịch vụ này?');">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Không có dữ liệu dịch vụ.</td></tr> }
    </tbody>
</table>
</div>
