# RavenDB Configuration Example
# ASP.NET Core đọc biến môi trường theo quy ước <Section>__<Key> (hai dấu gạch dưới).
# Các biến dưới đây ghi đè appsettings.json. Có thể export trong shell, khai báo trong
# launchSettings.json, dùng appsettings.Development.json, hoặc truyền bằng `docker run -e`.
# KHÔNG commit file .env thật (.gitignore đã loại trừ .env).

# ----- Kết nối RavenDB -----
RavenSettings__Urls__0=http://127.0.0.1:8080
RavenSettings__DatabaseName=CustomerCareDB

# Chỉ cần khi RavenDB bật HTTPS + xác thực bằng client certificate (.pfx).
# CertificateBase64 (nội dung .pfx mã hóa Base64, `base64 -w0 cert.pfx`) được ưu tiên hơn CertificatePath.
# Không commit file .pfx lên Git (.gitignore đã loại trừ *.pfx).
# RavenSettings__CertificateBase64=
# RavenSettings__CertificatePath=/path/to/client-certificate.pfx
# RavenSettings__CertificatePassword=

# Tự tạo database khi khởi động (mặc định true). Thiếu quyền nhưng database đã tồn tại thì vẫn chạy tiếp.
# RavenSettings__EnsureDatabaseOnStartup=true

# Hiển thị liên kết RavenDB Studio (mặc định true; image Docker đặt false vì RavenDB chỉ chạy nội bộ).
# RavenSettings__StudioEnabled=true

# ----- Dữ liệu mẫu -----
# Nạp dữ liệu mẫu khi khởi động (luôn bật trong Development; tương đương tham số --seed). Idempotent.
# Seed__OnStartup=true

# ----- Hosting -----
# Cổng lắng nghe (Render tự đặt PORT=10000). Không đặt -> dùng launchSettings/ASPNETCORE_URLS như bình thường.
# PORT=10000
# Tin header X-Forwarded-* khi chạy sau reverse proxy (Render).
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# Chuyển hướng HTTP -> HTTPS (mặc định bật, trừ khi chạy trong container).
# HttpsRedirection__Enabled=true
# Lưu Data Protection key (cookie antiforgery) vào RavenDB (mặc định true).
# DataProtection__PersistKeysToRavenDb=true

# ----- Chỉ dùng cho image Docker (docker/entrypoint.sh) -----
# Chạy RavenDB nhúng trong container (mặc định true). false = dùng RavenDB bên ngoài.
# EMBEDDED_RAVENDB=true
# Số giây tối đa chờ RavenDB nhúng sẵn sàng.
# RAVEN_WAIT_SECONDS=300

# ----- Kiểm thử -----
# URL RavenDB cho test tích hợp (mặc định http://127.0.0.1:8080).
# RAVEN_TEST_URL=http://127.0.0.1:8080

# Bật/tắt endpoint chạy RQL trực tiếp (/Diagnostic/ExecuteRql).
# Mặc định: true trong Development (appsettings.Development.json), false ở môi trường khác.
# Diagnostics__EnableRqlEndpoint=false
